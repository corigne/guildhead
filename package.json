{
  "name": "guildhead",
  "version": "1.4.0",
  "private": true,
  "description": "Discord bot that enriches synced World of Warcraft guild chat with Wowhead tooltips.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corigne/guildhead.git"
  },
  "keywords": [
    "discord-bot",
    "world-of-warcraft",
    "wowhead",
    "guild-chat",
    "typescript"
  ],
  "engines": {
    "node": ">=24.17.0"
  },
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "test": "npm run test:coverage",
    "test:unit": "npm run build && node --test --test-concurrency=1 dist/test/*.test.js",
    "test:coverage": "npm run build && node --experimental-test-coverage --test-coverage-include='dist/src/**/*.js' --test-coverage-exclude='dist/src/index.js' --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 --test --test-concurrency=1 dist/test/*.test.js"
  },
  "dependencies": {
    "discord.js": "14.28.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
